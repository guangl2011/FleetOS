{
  "name": "@fleetos/console",
  "version": "0.1.0",
  "private": true,
  "description": "FleetOS operator console — React (Vite) operator surface: fleet map/list, schedule board, exception queue with intervention actions, device-agent proposal review, benchmark results, and per-device compliance surfacing",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@fleetos/adapters-sdk": "workspace:*",
    "@fleetos/core-schema": "workspace:*",
    "@fleetos/device-agents": "workspace:*",
    "@fleetos/fleet-health": "workspace:*",
    "@fleetos/scheduler": "workspace:*",
    "@fleetos/world-model": "workspace:*",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}
