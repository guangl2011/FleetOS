{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
    },
    "planId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "assignments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "robotId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "taskId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "startAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          },
          "estMinutes": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "riskNotes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            }
          }
        },
        "required": [
          "robotId",
          "taskId",
          "startAt",
          "estMinutes",
          "riskNotes"
        ],
        "additionalProperties": false
      }
    },
    "projected": {
      "type": "object",
      "properties": {
        "onTimeCompletion": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "expectedInterventions": {
          "type": "number",
          "minimum": 0
        },
        "minBatteryReservePct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      },
      "required": [
        "onTimeCompletion",
        "expectedInterventions",
        "minBatteryReservePct"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "planId",
    "createdAt",
    "assignments",
    "projected"
  ],
  "additionalProperties": false,
  "$id": "dispatch-plan.schema.json",
  "title": "FleetOS Dispatch Plan",
  "description": "Scheduling-core output: robot-task assignments with projected on-time completion, expected interventions, and minimum battery reserve."
}
