{
  "name": "@fleetos/core-schema",
  "version": "0.1.0",
  "private": true,
  "description": "FleetOS capability ontology — vendor-neutral domain schemas (Zod) with generated JSON Schema artifacts",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schemas/*": "./schemas/*"
  },
  "scripts": {
    "generate": "tsx scripts/generate-schemas.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "tsx": "^4.19.2",
    "vitest": "^3.2.4"
  }
}
