{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "seq": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "actorType": {
      "type": "string",
      "enum": [
        "operator",
        "system",
        "scheduler",
        "device-agent"
      ]
    },
    "actorId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "action": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "subjectType": {
      "type": "string",
      "enum": [
        "robot",
        "task",
        "plan",
        "exception",
        "agent-proposal",
        "constraint-pack"
      ]
    },
    "subjectId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "planId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "detail": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "required": [
    "seq",
    "at",
    "actorType",
    "actorId",
    "action",
    "subjectType",
    "subjectId"
  ],
  "additionalProperties": false,
  "$id": "audit-event.schema.json",
  "title": "FleetOS Audit Event",
  "description": "One append-only audit entry — the compliance and incident evidence base for every state change."
}
