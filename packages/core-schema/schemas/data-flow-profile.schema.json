{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "oemCloud": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "traversedJurisdictions": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z]{2}$"
      }
    },
    "telemetryFieldAllowlist": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]{0,63}$"
      }
    }
  },
  "required": [
    "oemCloud",
    "traversedJurisdictions",
    "telemetryFieldAllowlist"
  ],
  "additionalProperties": false,
  "$id": "data-flow-profile.schema.json",
  "title": "FleetOS Data Flow Profile",
  "description": "Where a robot's telemetry goes: the OEM cloud it traverses, the jurisdictions it transits, and the minimized telemetry field set."
}
